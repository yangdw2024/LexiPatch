{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "译铸 LexiPatch",
  "version": "2.0.1",
  "identifier": "com.lexipatch.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "译铸 LexiPatch v2.0",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "backgroundColor": "#0A0E14",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/*"
    ]
  }
}
